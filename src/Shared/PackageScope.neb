local packageApi: any = Package
local debugApi: any = debug
local ownPackage: string? = nil
if type(packageApi) == "table" and type(packageApi.GetName) == "function" then
  ownPackage = packageApi.GetName()
end

export function getCallingPackage(): string?
  if ownPackage == nil or debugApi == nil then
    return nil
  end

  local level = 2
  while true do
    local info = debugApi.getinfo(level, "S")
    if info == nil then
      return nil
    end

    local source = string.gsub(tostring(info.source), "^@", "")
    local name = string.match(source, "^([%w%-_%.]+)[/\\]")
    if name ~= nil and name ~= ownPackage then
      return name
    end

    level = level + 1
  end
end
